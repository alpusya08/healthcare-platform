# ════════════════════════════════════════════════════════════════
#  PRODUCTION ENV — copy to .env.prod, fill in values, keep secret
# ════════════════════════════════════════════════════════════════

# ─── Domain (set to your domain OR server IP) ────────────────
DOMAIN=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ─── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=healthcare
POSTGRES_USER=healthcare
POSTGRES_PASSWORD=CHANGE_ME_strong_password_32chars

AI_POSTGRES_DB=ai_feedback
AI_POSTGRES_USER=ai_feedback
AI_POSTGRES_PASSWORD=CHANGE_ME_another_strong_password

# ─── Redis ───────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password

# ─── MinIO ───────────────────────────────────────────────────
MINIO_ROOT_USER=medai_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password_16chars
MINIO_BUCKET=medical-files

# ─── JWT (generate: openssl rand -hex 64) ────────────────────
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_64

# ─── Internal token (generate: openssl rand -hex 32) ─────────
AI_SERVICE_INTERNAL_TOKEN=CHANGE_ME_internal_token

# ─── AI / LLM ────────────────────────────────────────────────
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OPENAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# GEMINI (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── Email (Gmail App Password) ──────────────────────────────
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password_16chars
